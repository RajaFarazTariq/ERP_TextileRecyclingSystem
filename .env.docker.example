# Copy to .env (in this folder, next to docker-compose.yml) to override the
# Docker defaults. backend/.env still holds SECRET_KEY and email settings.

POSTGRES_PASSWORD=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Port the site is served on, and HTTPS-only cookies (true only when served over HTTPS)
APP_PORT=8080
SECURE_COOKIES=false
