# Copy to .env (in this folder, next to docker-compose.yml) to override the
# Docker defaults. backend/.env still holds SECRET_KEY and email settings.

POSTGRES_PASSWORD=change-me
WEB_PORT=8080
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# New app port, and HTTPS-only cookies (true only when served over HTTPS)
APP_PORT=8081
SECURE_COOKIES=false
LEGACY_APP_URL=http://localhost:8080
