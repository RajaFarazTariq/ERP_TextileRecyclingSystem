# Copy this file to .env and fill in real values. Never commit .env.

# ── Django ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────
# DB_ENGINE=sqlite uses a local db.sqlite3 instead (tests only)
DB_ENGINE=postgresql
DB_NAME=ERP_DB
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Email (Gmail SMTP) ────────────────────────────────────
# Leave EMAIL_HOST_USER empty to print emails to the console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
MANAGEMENT_EMAIL=
