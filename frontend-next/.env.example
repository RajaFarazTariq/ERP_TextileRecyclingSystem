# Copy to .env.local for local development.

# Django API (server-side only; the browser never talks to Django directly)
DJANGO_API_URL=http://127.0.0.1:8000/api/v1/

# Where pages that haven't moved to this app yet are served (the classic app)
NEXT_PUBLIC_LEGACY_APP_URL=http://localhost:3000

# Set to true when the site is served over HTTPS
SECURE_COOKIES=false
